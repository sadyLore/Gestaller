<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 🔹 Encabezado con logo -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:text="Nuevo trabajo"
                android:textColor="@color/gestaller_blue"
                android:textSize="22sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 🔹 Tarjeta del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_border_button"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etClientName"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_border_button"
                android:gravity="center_vertical"
                android:hint="Ingresar nombre"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/etClientPhone"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_border_button"
                android:gravity="center_vertical"
                android:hint="Número de teléfono"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="10dp">

                <Spinner
                    android:id="@+id/spBrand"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_border_button"
                    android:paddingHorizontal="20dp"
                    android:layout_marginEnd="8dp"/>

                <Spinner
                    android:id="@+id/spModel"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_border_button"
                    android:paddingHorizontal="20dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPlate"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_border_button"
                android:gravity="center_vertical"
                android:hint="Chapa"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorOnSurface" />

            <Button
                android:id="@+id/btnTomarFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📸 Tomar foto"
                android:background="@drawable/rounded_button"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="20dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_border_button"
                android:contentDescription="Vista previa de la foto"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/servicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_border_button"
                android:gravity="center_vertical"
                android:hint="Agregar nota"
                android:inputType="textMultiLine"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/rounded_border_button"
                    app:backgroundTint="@color/gestaller_blue"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Guardar"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/rounded_border_button"
                    app:backgroundTint="@color/gestaller_blue"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

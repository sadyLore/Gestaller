<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gestaller_blue"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ⋮ Menú de tres puntos -->
        <ImageView
            android:id="@+id/btnMoreOptions"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="Opciones"
            app:tint="@color/gestaller_blue_light" />

        <!-- 🧾 Nombre del cliente -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_toStartOf="@id/btnMoreOptions"
            android:layout_alignParentStart="true"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- 🚗 Vehículo y chapa -->
        <TextView
            android:id="@+id/tvClientVehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- 📅 Fecha -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvClientVehicle"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>

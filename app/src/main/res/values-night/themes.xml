<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema para el modo Noche -->
    <style name="Theme.Gestaller" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Atributos generales del tema noche -->
        <item name="colorPrimary">@color/gestaller_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Fondo principal de la app y componentes como CardView -->
        <item name="colorSurface">@color/gestaller_dialog_dark_background</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Color de texto por defecto -->
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorHint">@color/gestaller_gray</item>

        <!-- Estilos de componentes para modo Noche -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout.Night</item>

        <!-- Estilos para todos los diálogos en modo Noche -->
        <item name="alertDialogTheme">@style/Theme.App.Dialog.Alert.Night</item>
        <item name="dialogTheme">@style/Theme.App.Dialog.Night</item>
    </style>

    <!-- Estilo para Diálogos de Alerta -->
    <style name="Theme.App.Dialog.Alert.Night" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/gestaller_dialog_dark_background</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:windowBackground">@color/gestaller_dialog_dark_background</item>
    </style>

    <!-- Estilo para Diálogos generales (DialogFragments) -->
    <style name="Theme.App.Dialog.Night" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="colorSurface">@color/gestaller_dialog_dark_background</item>
        <item name="android:windowBackground">@drawable/dialog_night_background</item>
    </style>

    <!-- Estilo para TextInputLayout y EditText dentro de diálogos -->
    <style name="Widget.App.TextInputLayout.Night" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/gestaller_dialog_dark_background</item>
        <item name="android:textColorHint">@color/gestaller_gray</item>
    </style>
</resources>

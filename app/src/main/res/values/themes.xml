<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema Claro con paleta Gestaller -->
    <style name="Theme.Gestaller" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- BRAND: se mantiene en ambos modos -->
        <item name="colorPrimary">@color/gestaller_blue</item>
        <item name="colorPrimaryVariant">@color/gestaller_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Superficies / texto -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnBackground">@color/black</item>

        <!-- Secundarios / contenedores -->
        <item name="colorSecondary">@color/gestaller_gray</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurfaceVariant">@color/gestaller_gray</item>

        <!-- Componentes -->
        <item name="materialAlertDialogTheme">@style/App.MaterialAlertDialogTheme</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Estilo para diálogos con esquinas redondeadas -->
    <style name="App.MaterialAlertDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/App.Title.Light</item>
    </style>

    <style name="App.Title.Light" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/gestaller_blue</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Estilos de tipografía con sans-serif -->
    <style name="TextAppearance.App.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item> <!-- Medium weight -->
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.App.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item> <!-- Medium weight -->
    </style>

    <!-- Estilos para Items de Lista -->
    <style name="Widget.App.ListItemCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/item_card_border_color</item>
    </style>

    <style name="TextAppearance.App.ListItem.Title" parent="TextAppearance.App.Subtitle">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.App.ListItem.PrimaryText" parent="TextAppearance.App.Body">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.ListItem.SecondaryText" parent="TextAppearance.App.Caption">
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <!-- Estilo para botones redondeados -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button</item>
        <item name="backgroundTint">@color/gestaller_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/gestaller_blue</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="ShapeAppearance.App.Button" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- 🎨 Estilo para el BottomSheet -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottomsheet_rounded</item>
    </style>


</resources>
